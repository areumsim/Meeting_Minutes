# ── 비밀 설정 (절대 git에 올리지 말 것) ─────────
config.json
.env
.mcp.json

# ── 출력 파일 ─────────────────────────────────────
output/
*.log
*.log.*

# ── 빌드 산출물 ──────────────────────────────────
# build/ 는 repo root 전용으로 anchor (scripts/build/ 는 빌드 스크립트 소스 디렉토리라 별개)
/build/
dist/
*.tsbuildinfo

# ── Node ─────────────────────────────────────────
node_modules/

# ── iOS / Capacitor ──────────────────────────────
*.xcworkspace
xcuserdata/
DerivedData/
*.ipa
.swiftpm/
web/frontend/ios/App/App/public/
web/frontend/ios/App/Pods/

# ── 플랫폼별 바이너리 (esbuild, rollup 등) ──────
*.exe
*.node

# ── Python ────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── 데이터베이스 ─────────────────────────────────
*.db
*.db-wal
*.db-shm

# ── 임시 파일 ─────────────────────────────────────
*.tmp
*.bak
temp_*
.fuse_hidden*

# ── 오디오 백업 (크래시 복구용 대용량 파일) ─────────
# output/ 전체가 이미 무시되므로 아래는 명시적 문서화 목적
*.pcm
*.s16le
*.m4a
*.mp3
*.mp4
*.wav
*.webm
*.flac
*.aac
*.ogg

# ── 상태/인덱스 파일 (사용자별, git에 올리지 말 것) ─────
data/*.json

# bash 크래시 덤프
*.stackdump

# ── 개인 작업 메모 / 발표자료 ─────────────────────
/TODO.md
*.pptx
