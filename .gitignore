# ── 비밀 설정 (절대 git에 올리지 말 것) ─────────
config.json
config.local.json
# 손상 시 보관본(config_loader.recover). 실제 API 키가 그대로 들어 있는데 위
# `config.json` 은 정확 이름 매칭이라 걸리지 않았다(.bak/.tmp 는 아래 규칙이 잡는다).
config.json.corrupt-*
.env
.env.*
.mcp.json
# 자격증명 파일 일반형 — 위 목록은 "우리가 쓰는 파일명"만 막는다. 사내 CA 등록(ssl.ca_bundle)
# 이나 디버깅 중에 키·인증서를 리포에 두는 일이 실제로 생기므로 확장자로도 막는다.
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
secrets.*
credentials.*
*_credentials.json

# ── 출력 파일 ─────────────────────────────────────
output/
*.log
*.log.*

# ── 빌드 산출물 ──────────────────────────────────
# build/ 는 repo root 전용으로 anchor (scripts/build/ 는 빌드 스크립트 소스 디렉토리라 별개)
/build/
dist/
*.tsbuildinfo

# ── 벤더 바이너리 캐시 (빌드 스크립트가 다운로드/배치 — git에 올리지 않음) ─────
# 임베디드 파이썬은 build_portable.ps1 이 python.org에서 받아 vendor/python-embed/ 에 캐시.
# (vendor/ffmpeg/*.exe 는 위 *.exe 규칙으로 이미 제외됨)
vendor/python-embed/

# ── 사용자 데이터 (개인정보 — 회의 내용·실제 파일 경로·노트 본문이 들어간다) ─────
# 포터블 배포본의 데이터 폴더. 리포 안에서 배포본을 테스트하면 여기 생긴다.
# processed_audio.json(감시한 실제 녹음 경로), vault_index.json(노트 본문 인덱스),
# prompts/ 는 어떤 확장자 규칙에도 걸리지 않아 그대로 커밋될 수 있었다.
MeetingMinutesData/
# 처리 대기 오디오와 그 산출물. 오디오 확장자는 아래에서 막지만 폴더 안의 전사·메모
# (.txt/.md/.json)는 안 막혀 회의 내용이 그대로 올라갈 수 있었다.
input/

# ── 작업 중 만든 백업 잔재 ────────────────────────
# 이름을 하나씩 적으면 다음 백업(-2, -old …)이 새 나간다. 이 폴더들에는 실제 API 키가
# 든 config.json 사본이 있다(2026-07-31 확인).
.recording-fix-backup*/
*-backup/
*-backup-*/
*.backup/

# ── Node ─────────────────────────────────────────
node_modules/

# ── iOS / Capacitor ──────────────────────────────
*.xcworkspace
xcuserdata/
DerivedData/
*.ipa
.swiftpm/
web/frontend/ios/App/App/public/
web/frontend/ios/App/Pods/

# ── 플랫폼별 바이너리 (esbuild, rollup 등) ──────
*.exe
*.node

# ── Python ────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
.pytest_cache/

# ── 데이터베이스 ─────────────────────────────────
*.db
*.db-wal
*.db-shm
# 마이그레이션 전 손으로 뜬 백업(wiki_graph.db.bak_20260730 등) — *.db/*.bak 어느 패턴에도
# 걸리지 않아 실수로 커밋될 수 있었다. 사용자 데이터이고 수백 KB~수 MB다.
*.db.bak*

# ── 임시 파일 ─────────────────────────────────────
*.tmp
*.bak
temp_*
.fuse_hidden*

# ── 오디오 백업 (크래시 복구용 대용량 파일) ─────────
# output/ 전체가 이미 무시되므로 아래는 명시적 문서화 목적
*.pcm
*.s16le
*.m4a
*.mp3
*.mp4
*.wav
*.webm
*.flac
*.aac
*.ogg

# ── 상태/인덱스 파일 (사용자별, git에 올리지 말 것) ─────
data/*.json

# bash 크래시 덤프
*.stackdump

# ── 개인 작업 메모 / 발표자료 ─────────────────────
/TODO.md
*.pptx
_tmp*.txt
tmp_*.txt
# 위 두 패턴은 `tmp.txt`(구분자 없는 이름)를 잡지 못해 매 git status 에 떴고,
# 실수로 커밋될 수 있었다 — 개인 키·메모가 들어있는 스크래치 파일이다.
tmp*.txt
# 문서 검토용 대용량 파생 자료 — 456KB DOM 덤프로 재생성 가능하고 git diff 가 무의미하다.
# 갭 분석 근거는 docs/prd/PRD_v1.0.0.md 부록 E 에서 실제 소스 file:line 으로 이전됐다.
# (*.html 블랭킷 금지 — web/frontend/index.html 이 추적 대상이다)
docs/prd/webui_current_snapshot.html
